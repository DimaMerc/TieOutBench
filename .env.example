# TieOutBench API keys — copy this file to `.env` (gitignored, never commit) and fill in real
# values, or set the same names as environment variables (the environment always wins over .env).
# Keys are only needed for LIVE model runs; everything deterministic runs offline with no key.
#
# The harness resolves the key FROM THE ENDPOINT (harness/live.py resolve_key):
#   api.anthropic.com  -> ANTHROPIC_API_KEY   (console.anthropic.com)
#   api.openai.com     -> OPENAI_API_KEY      (platform.openai.com)
#   googleapis.com     -> GEMINI_API_KEY      (aistudio.google.com)
#   LM Studio (local)  -> no key needed

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
